# true = fake AI (no keys needed). false = real ElevenLabs + real translation.
MOCK_SERVICES=true

# ElevenLabs: speech-to-text (Scribe), text-to-speech, and voice matching. Server-side only.
# Permissions needed: Text to Speech, Speech to Text, Voices (read).
# Voice matching ("sound like the speaker") also needs Voices (write) and a plan that allows
# instant voice cloning. Without it, Fluid says so once and keeps using the stock voices.
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_STT_MODEL_ID=scribe_v2
# Optional: voice used when a user has not picked one
ELEVENLABS_DEFAULT_VOICE_ID=

# Translation: MyMemory works with no key. Add a DeepL key for better quality.
DEEPL_API_KEY=
MYMEMORY_EMAIL=

# Database: leave false for the in-memory demo store.
USE_POSTGRES=false
DATABASE_URL=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional relay for audio/video when networks block direct connections (campus Wi-Fi).
# Cloudflare Realtime TURN (dashboard: Realtime -> TURN -> create key):
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_KEY_API_TOKEN=
# ...or any other TURN server:
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
